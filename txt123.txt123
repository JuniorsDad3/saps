@app.route('/log-case', methods=['POST'])
def log_case():
    """
    Handle case logging.
    """
    try:
        # Extract form data
        name = request.form.get("name")
        surname = request.form.get("surname")
        id_number = request.form.get("idNumber")
        cell_number = request.form.get("cellNumber")
        email = request.form.get("email")
        address = request.form.get("address")
        incident_type = request.form.get("incidentType")
        incident_date_time = request.form.get("incidentDateTime")
        incident_description = request.form.get("incidentDescription")

        # Save uploaded files
        voice_note = request.files.get("voiceNote")
        images = request.files.getlist("images")
        videos = request.files.getlist("videos")

        # Save files to uploads folder
        if voice_note:
            voice_note.save(os.path.join(app.config["UPLOADS_FOLDER"], voice_note.filename))
        for image in images:
            image.save(os.path.join(app.config["UPLOADS_FOLDER"], image.filename))
        for video in videos:
            video.save(os.path.join(app.config["UPLOADS_FOLDER"], video.filename))

        # Simulate saving data (e.g., database or logging)
        case_data = {
            "name": name,
            "surname": surname,
            "id_number": id_number,
            "cell_number": cell_number,
            "email": email,
            "address": address,
            "incident_type": incident_type,
            "incident_date_time": incident_date_time,
            "incident_description": incident_description,
            "files": {
                "voice_note": voice_note.filename if voice_note else None,
                "images": [image.filename for image in images],
                "videos": [video.filename for video in videos],
            },
        }
        print(f"Case logged: {case_data}")

        return jsonify({"message": "Case logged successfully!", "data": case_data}), 200

    except Exception as e:
        print(f"Error logging case: {e}")
        return jsonify({"error": "An error occurred while logging the case."}), 500

@app.route('/tip-off', methods=['POST'])
def tip_off():
    """
    Handle anonymous tip-offs.
    """
    try:
        tipoff_details = request.form.get("tipoff_details")
        timestamp = datetime.datetime.now().isoformat()

        # Simulate saving tip-off (e.g., database or log)
        print(f"Tip-off received at {timestamp}: {tipoff_details}")

        return jsonify({"message": "Tip-off submitted successfully!"}), 200

    except Exception as e:
        print(f"Error submitting tip-off: {e}")
        return jsonify({"error": "An error occurred while submitting the tip-off."}), 500

