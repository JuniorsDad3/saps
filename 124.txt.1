            return jsonify({'error': f"Failed to upload signed document: {blob_url}"}), 500

        return jsonify({
            'message': 'Document certified successfully.',
            'download_url': blob_url,
            'signed_file_path': signed_file_path  # Include for email purposes
        })

    return jsonify({'error': 'Invalid file type'}), 400

@app.route('/email', methods=['POST'])
