@app.route('/stamp', methods=['POST'])
def stamp_signature(pdf_path, signature_path):
    output_path = os.path.join(app.config['DOWNLOAD_FOLDER'], f"signed_{os.path.basename(pdf_path)}")

    try:
        # Read the PDF and create an overlay with the signature
        pdf_reader = PdfReader(pdf_path)
        pdf_writer = PdfWriter()

        for page in pdf_reader.pages:
            packet = BytesIO()
            c = canvas.Canvas(packet, pagesize=letter)
            c.drawImage(signature_path, x=400, y=100, width=100, height=50)  # Adjust as needed
            c.save()

            packet.seek(0)
            overlay_pdf = PdfReader(packet)
            page.merge_page(overlay_pdf.pages[0])
            pdf_writer.add_page(page)

        with open(output_path, "wb") as output_file:
            pdf_writer.write(output_file)

        return output_path
    except Exception as e:
        print(f"Error stamping signature: {e}")
        return None

