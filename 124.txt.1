def stamp_signature(pdf_path, signature_path):
    # Temporary output path
    output_path = os.path.join(app.config['UPLOAD_FOLDER'], 'signed_document.pdf')

    # Read the existing PDF
    pdf_reader = PdfReader(pdf_path)
    pdf_writer = PdfWriter()

    # Add signature to each page
    for page in pdf_reader.pages:
        packet = BytesIO()
        c = canvas.Canvas(packet, pagesize=letter)

        # Set the position and size of the signature
        c.drawImage(signature_path, x=400, y=100, width=100, height=50)  # Adjust position/size as needed
        c.save()

        packet.seek(0)
        overlay_pdf = PdfReader(packet)
        page.merge_page(overlay_pdf.pages[0])
        pdf_writer.add_page(page)

    # Write out the signed document
    with open(output_path, "wb") as output_file:
        pdf_writer.write(output_file)

    return output_path

