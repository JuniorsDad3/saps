        '7000': 'Cape Flats Police Station', 
    }
    
    # Fetch the nearest police station based on postal code
    nearest_station = postal_code_stations.get(postal_code, 'Unknown Station')

    # Handle form data
    name = data.get('name')
    surname = data.get('surname')
    id_number = data.get('id_number')
    cellphone = data.get('cellphone')
    email = data.get('email')
    address = data.get('address')
    date_time = data.get('date_time')
    crime_type = data.get('crime_type')
    description = data.get('description', '')

    # Generate a unique reference number
    reference_number = generate_reference_number()
    response['reference_number'] = reference_number
    
    # Handle language translation
    language = data.get('language', 'en')
    translated_description = translator.translate(description, src='en', dest=language).text
    response['translated_description'] = translated_description

    # Handle media uploads (image, video, documents)
    uploaded_files = []
    for file_key in ['image', 'video', 'document']:
        if file_key in request.files:
            file = request.files[file_key]
            if file and allowed_file(file.filename):
                filename = secure_filename(file.filename)
                filepath = os.path.join(app.config['UPLOAD_FOLDER'], filename)
                file.save(filepath)
                uploaded_files.append(filepath)
    response['uploaded_files'] = uploaded_files

    # Save case details
    case_log = {
        'reference_number': reference_number,
        'name': name,
        'surname': surname,
        'id_number': id_number,
        'cellphone': cellphone,
        'email': email,
        'address': address,
        'date_time': date_time,
        'crime_type': crime_type,
        'description': description,
        'translated_description': translated_description,
        'uploaded_files': uploaded_files,
        'case_state': 'Open',
    }
    
    case = Case(**case_log)
    db.session.add(case)
    db.session.commit()

    return jsonify(response)

# Certify Document Route
@app.route('/certify_document', methods=['POST'])
def certify_document():
    file = request.files.get('file')
    user_name = request.form.get('name')
    user_email = request.form.get('email')

    if not file or file.filename == '':
        return jsonify({"message": "No file uploaded"}), 400

    if file and allowed_file(file.filename):
        # Save the uploaded file
        file_path = os.path.join(app.config['UPLOAD_FOLDER'], secure_filename(file.filename))
        file.save(file_path)

        # Add the signature to the document
        signature_path = os.path.join(app.config['UPLOAD_FOLDER'], 'signature.png')
        if not os.path.exists(signature_path):
            return jsonify({"message": "Signature file not found!"}), 400

        signed_path = stamp_signature(file_path, signature_path)

        # Email the signed document
        msg = Message(
            "Certified Document",
            sender=os.getenv('MAIL_USERNAME'),
            recipients=[user_email]
        )
        msg.body = f"Dear {user_name},\n\nYour document has been successfully certified."
        with open(signed_path, 'rb') as signed_file:
            msg.attach("signed_document.pdf", "application/pdf", signed_file.read())
        mail.send(msg)

        # Return a download link
        download_url = url_for('download_file', filename=f"signed_{file.filename}")
        return jsonify({"message": "Document certified and emailed successfully", "download_link": download_url})
    else:
        return jsonify({"message": "Invalid file type"}), 400

